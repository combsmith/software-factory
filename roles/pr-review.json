{
  "schema": "role/1",
  "name": "pr-review",
  "kind": "owner",
  "owns": [
    "functional",
    "security",
    "architecture",
    "delivery",
    "reliability",
    "requirements",
    "uncategorised"
  ],
  "app": "combsmith-sf-pr-review",
  "lens": {
    "scope": {
      "paths": [
        "**"
      ],
      "exclude": [],
      "always": true
    },
    "raises": [
      "functional",
      "security",
      "architecture",
      "delivery",
      "reliability",
      "requirements",
      "uncategorised"
    ]
  },
  "intents": [
    {
      "name": "review-change",
      "tier": "standard",
      "permitted_effects": [
        "submit_review",
        "create_check_run"
      ],
      "budget_class": "gate",
      "evals": "evals/pr-review"
    }
  ]
}
