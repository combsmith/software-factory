    {"request": {"as": {"kind": "person", "name": "don-petry"}, "via": "graphql", "call": "POST /graphql (gh api graphql): the facts port's own query, adapters/checks.py QUERY at PAGE 100, word for word, its variables as the port sends them, of canary pull request 100; the answer kept whole, of its headers the date, x-github-request-id and link alone", "headers": {"accept": "application/vnd.github+json"}, "body": {"query": "query FactsChecks($owner: String!, $name: String!, $number: Int!, $after: String) {\n  repository(owner: $owner, name: $name) {\n    pullRequest(number: $number) {\n      headRefOid\n      mergeQueueEntry { position }\n      commits(last: 1) {\n        nodes {\n          commit {\n            oid\n            statusCheckRollup {\n              contexts(first: 100, after: $after) {\n                totalCount\n                pageInfo { hasNextPage endCursor }\n                nodes {\n                  __typename\n                  ... on StatusContext { id }\n                  ... on CheckRun {\n                    id databaseId name conclusion status startedAt completedAt detailsUrl\n                    checkSuite { conclusion app { databaseId } workflowRun { databaseId file { path } } }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}", "variables": {"owner": "combsmith", "name": "software-factory-canary", "number": 100, "after": null}}}, "response": {"status": 200, "headers": {"date": "Fri, 13 Nov 2026 12:29:54 GMT", "x-github-request-id": "C5E9:1DA642:55AF6F5:11074393:6AF702C1"}, "body": {"data": {"repository": {"pullRequest": {"headRefOid": "49e59571af12062938b9e5513a297dfa76ab23dd", "mergeQueueEntry": null, "commits": {"nodes": [{"commit": {"oid": "49e59571af12062938b9e5513a297dfa76ab23dd", "statusCheckRollup": {"contexts": {"totalCount": 6, "pageInfo": {"hasNextPage": false, "endCursor": "Ng"}, "nodes": [{"__typename": "CheckRun", "id": "CR_kwDOVFD6788AAAAeFI86Rw", "da