        "via": "graphql",
        "call": "POST /graphql (gh api graphql): the five trial pull requests 37 (left a draft), 38 (marked ready, converted to draft, marked ready again), 39 (merged to trial/p-33-base, not the default), 40 (closed unmerged) and 41 (open, to trial/p-33-base), each with 'Closes #36' in its description, read as the port will read a linked pull request",
        "headers": {},
        "body": {
          "query": "query P33($owner: String!, $name: String!) {\n  repository(owner: $owner, name: $name) {\n    nameWithOwner\n    draft: pullRequest(number: 37) { ...PR }\n    open: pullRequest(number: 38) { ...PR }\n    merged: pullRequest(number: 39) { ...PR }\n    closed: pullRequest(number: 40) { ...PR }\n    nondefault: pullRequest(number: 41) { ...PR }\n  }\n}\nfragment PR on PullRequest {\n  number state isDraft baseRefName headRefName createdAt mergedAt closedAt\n  author { login __typename }\n  authorAssociation\n  mergedBy { login __typename }\n  closingIssuesReferences(first: 10) { totalCount nodes { number } }\n  timelineItems(itemTypes: [READY_FOR_REVIEW_EVENT, CONVERT_TO_DRAFT_EVENT], first: 20) {\n    totalCount\n    nodes {\n      __typename\n      ... on ReadyForReviewEvent { actor { login __typename } createdAt }\n      ... on ConvertToDraftEvent { actor { login __typename } createdAt }\n    }\n  }\n}\n",
