      "repos/*/*/pulls/*/merge"
    ]
  },
  "settings": {
    "commands": [
      "repo edit"
    ],
    "mutations": [
      "*RepositoryRuleset"
    ],
    "endpoints": [
      "repos/*/*/rulesets/**"
    ]
  }
}
