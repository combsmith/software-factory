{
  "approver": "donpetry-bot",
  "author_role": "dev-lead",
  "owner_role": "pr-review",
  "required_lenses": {
    "deterministic": [
      "verify",
      "secret-scan",
      "code-scanning"
    ],
    "model": [
      "pr-review"
    ],
    "model_not_required_for": [
      "dependency"
    ]
  },
  "check_conclusions": {
    "success": "passing",
    "failure": "failing",
    "timed_out": "failing",
    "queued": "pending",
    "in_progress": "pending",
    "pending": "pending",
    "neutral": "passing",
    "skipped": "unreadable",
    "cancelled": "unreadable",
    "stale": "unreadable",
    "action_required": "unreadable",
    "startup_failure": "unreadable",
    "error": "unreadable"
  },
  "limits": {
    "max_attempts": 3,
    "max_rounds": 3,
    "max_runs_per_item": 10,
    "max_unmerged_closes": 1,
    "org_max_active_runs": 4,
    "max_diff_lines": 4000,
    "max_acts_per_item": 6
  }
}
