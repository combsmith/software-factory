{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What a change must show to be correct, written before the work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item",
    "criteria",
    "protected_paths"
  ],
  "properties": {
    "schema": {
      "const": "acceptance/1"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "priority",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "test",
                  "scenario",
                  "mutation",
                  "static",
                  "role",
                  "human"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "protected_paths": {
      "description": "What apply refuses any change to by the Role that does the work (design section 3.13): in the syntax of config/hooks.json's paths, read alike by the Kernel's matcher (kernel/derive.py, matches) and the session hooks' (tools/hooks/protected.py, entries): relative to the top of the repo; a path ending in / is a directory and all below it; * stands for any part of one name; ** as a whole name for any run of names, which both matchers read, as a rubric's paths use it (decision 0029), though config/hooks.json itself names none; case is ignored (issue 740, decision 0020).",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "hooks.schema.json#/$defs/path"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "type",
        "number"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "type": {
          "enum": [
            "pull_request",
            "issue"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
