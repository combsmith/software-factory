{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What a change must show to be correct, written before the work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item",
    "criteria",
    "protected_paths"
  ],
  "properties": {
    "schema": {
      "const": "acceptance/1"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "priority",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "test",
                  "scenario",
                  "mutation",
                  "static",
                  "role",
                  "human"
                ]
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "type",
        "number"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "type": {
          "enum": [
            "pull_request",
            "issue"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
