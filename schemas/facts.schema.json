{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Facts: what GitHub holds about one pull request, read in one pass. No prose.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "item",
    "state",
    "is_draft",
    "class",
    "author",
    "last_pusher",
    "targets_protected",
    "mergeable",
    "content_id",
    "diff",
    "labels",
    "admitted_at",
    "last_push_at",
    "last_writer_action_at",
    "reviews",
    "threads",
    "checks",
    "queue",
    "acts_since_writer",
    "complete",
    "read_at"
  ],
  "properties": {
    "schema": {
      "const": "facts/1"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "state": {
      "enum": [
        "open",
        "closed",
        "merged"
      ]
    },
    "is_draft": {
      "type": "boolean"
    },
    "class": {
      "enum": [
        "agent",
        "maintainer",
        "dependency",
        "outside"
      ]
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "last_pusher": {
      "type": "string",
      "minLength": 1
    },
    "targets_protected": {
      "type": "boolean"
    },
    "mergeable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "content_id": {
      "$ref": "#/$defs/content_id"
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "lines",
        "truncated"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "admitted_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "last_push_at": {
      "$ref": "#/$defs/time"
    },
    "last_writer_action_at": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "by",
          "state",
          "commit",
          "content_id",
          "submitted_at",
          "dismissed_by",
          "dismissed_from"
        ],
        "properties": {
          "by": {
            "$ref": "#/$defs/actor"
          },
          "state": {
            "description": "As GitHub holds it now: a review that was dismissed is dismissed, whatever it said.",
            "enum": [
              "approved",
              "changes_requested",
              "commented",
              "dismissed"
            ]
          },
          "commit": {
            "type": "string"
          },
          "content_id": {
            "$ref": "#/$defs/content_id"
          },
          "submitted_at": {
            "$ref": "#/$defs/time"
          },
          "dismissed_by": {
            "description": "Who dismissed the review, from the timeline; null unless it was dismissed.",
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "can_write"
            ],
            "properties": {
              "kind": {
                "$ref": "#/$defs/actor_kind"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "can_write": {
                "type": "boolean"
              }
            }
          },
          "dismissed_from": {
            "description": "What a dismissed review was before, from the timeline (previousReviewState); null unless it was dismissed.",
            "enum": [
              "approved",
              "changes_requested",
              "commented",
              null
            ]
          }
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resolved",
          "opened_by",
          "category",
          "severity",
          "resolved_by",
          "opened_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "opened_by": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "can_write"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "human",
                  "lens"
                ]
              },
              "name": {
                "type": "string"
              },
              "can_write": {
                "type": "boolean"
              }
            }
          },
          "category": {
            "description": "The Finding's category, as the authority table names it: a person's thread is human. A required Lens's, and its severity, come from its own Finding record joined by surface.key, never the comment text; null there is unreadable. Null for a Lens that writes it only as prose. A security Finding gates at any severity",
            "enum": [
              "functional",
              "security",
              "architecture",
              "delivery",
              "reliability",
              "requirements",
              "mechanical",
              "uncategorised",
              "human",
              null
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor",
              "info",
              null
            ]
          },
          "resolved_by": {
            "type": [
              "string",
              "null"
            ]
          },
          "opened_at": {
            "$ref": "#/$defs/time"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "app_id",
          "conclusion",
          "completed_at"
        ],
        "properties": {
          "name": {
            "description": "The check run's name exactly as GitHub gives it. The port's contract: it gives every check run on the head with its exact name and the id of the App that really reported it, from every App, and never drops, merges or renames one. The Kernel matches a check to a required deterministic Lens by the Lens's `check` in the configuration, exactly. Only a re-run of the same job in the same check suite replaces an earlier run (GitHub's filter=latest is per check suite), so two workflow runs on one commit both stay, and both are read",
            "type": "string"
          },
          "app_id": {
            "description": "The id of the App that reported the check, as GitHub gives it: the check run's app.id. A required Lens is read only from the App the configuration names for it",
            "type": "integer",
            "minimum": 1
          },
          "conclusion": {
            "description": "GitHub's own conclusion, or the check's status while it has not concluded. The port maps nothing; config check_conclusions says what each means.",
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "completed_at": {
            "description": "When the check completed, as GitHub says; null while it has not. An item's wait counts from the newest time it moved",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          }
        }
      }
    },
    "queue": {
      "type": "boolean"
    },
    "acts_since_writer": {
      "type": "integer",
      "minimum": 0
    },
    "complete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviews",
        "threads",
        "checks",
        "diff",
        "runs",
        "timeline"
      ],
      "properties": {
        "reviews": {
          "type": "boolean"
        },
        "threads": {
          "type": "boolean"
        },
        "checks": {
          "type": "boolean"
        },
        "diff": {
          "type": "boolean"
        },
        "runs": {
          "type": "boolean"
        },
        "timeline": {
          "type": "boolean"
        }
      }
    },
    "read_at": {
      "$ref": "#/$defs/time"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "type",
        "number"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "type": {
          "enum": [
            "pull_request",
            "issue"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "actor": {
      "description": "Who submitted a review, and whether they have write access, as a thread's opened_by says",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "can_write"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/actor_kind"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "can_write": {
          "type": "boolean"
        }
      }
    },
    "actor_kind": {
      "enum": [
        "human",
        "lens"
      ]
    },
    "time": {
      "description": "UTC, to the second, each field in its range. That the day is one its month has, the Kernel checks",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{4,64}$"
    }
  }
}
