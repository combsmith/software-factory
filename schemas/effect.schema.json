{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "effect/1: the Effects one Result asks for, one list for each type, so that a list's shape is the one its type needs. A type a Result may not request has no list here. The name and conclusion of a check run, the commit a review is on and the actor are apply's, never the Result's.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "submit_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "comments",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding",
                "body"
              ],
              "properties": {
                "finding": {
                  "type": "string",
                  "pattern": "^n[0-9]{1,3}$"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "create_check_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "annotations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding",
                "body"
              ],
              "properties": {
                "finding": {
                  "type": "string",
                  "pattern": "^n[0-9]{1,3}$"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "resolve_thread": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "thread"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "thread": {
            "type": "string",
            "pattern": "^PRRT_[A-Za-z0-9_-]+$"
          }
        }
      }
    },
    "comment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "on",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{1,3}$"
          },
          "on": {
            "type": "string",
            "pattern": "^(item|PRRT_[A-Za-z0-9_-]+)$"
          },
          "body": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "type": {
      "enum": [
        "submit_review",
        "create_check_run",
        "resolve_thread",
        "comment"
      ]
    }
  }
}
