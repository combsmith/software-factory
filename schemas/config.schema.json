{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What the Kernel is told about required Lenses, Roles and limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approver",
    "author_role",
    "owner_role",
    "required_lenses",
    "status_on_item",
    "check_conclusions",
    "limits"
  ],
  "properties": {
    "approver": {
      "type": "string"
    },
    "author_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "required_lenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "model",
        "model_not_required_for"
      ],
      "properties": {
        "deterministic": {
          "description": "Each deterministic Lens, by the name of the check GitHub reports, and the id of the one App whose check it is read from",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "app_id"
            ],
            "properties": {
              "lens": {
                "type": "string",
                "minLength": 1
              },
              "app_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "model": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "model_not_required_for": {
          "type": "array",
          "items": {
            "enum": [
              "dependency"
            ]
          }
        }
      }
    },
    "status_on_item": {
      "description": "The one name of the check run the Controller posts as the status on the item. tools/check_authority.py refuses a required Lens's name: the status would speak for that Lens",
      "type": "string",
      "minLength": 1
    },
    "check_conclusions": {
      "description": "What each conclusion GitHub gives a required check means, by its own name. A conclusion the map does not name is unreadable. Only success passes: any other name maps to failing, pending or unreadable.",
      "type": "object",
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "const": "passing"
        }
      },
      "additionalProperties": {
        "enum": [
          "failing",
          "pending",
          "unreadable"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "max_rounds",
        "max_runs_per_item",
        "max_unmerged_closes",
        "org_max_active_runs",
        "max_diff_lines",
        "max_acts_per_item"
      ],
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_runs_per_item": {
          "type": "integer",
          "minimum": 1
        },
        "max_unmerged_closes": {
          "type": "integer",
          "minimum": 1
        },
        "org_max_active_runs": {
          "type": "integer",
          "minimum": 1
        },
        "max_diff_lines": {
          "type": "integer",
          "minimum": 1
        },
        "max_acts_per_item": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
