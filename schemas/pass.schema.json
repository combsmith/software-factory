{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pass/1: what one pass of the Controller read and decided, enough to replay every Decision it made: the time it gave the Kernel, what started it, the whole context, every run record, each read's date and age, and for each item its facts, its Decision and the Run id minted for an admission, an approval or a queue act once the queue workflow is named. The configuration is the data at release. There is no title anywhere in it: the facts have no field for one, so a replay, like the Kernel, never sees one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pass",
    "release",
    "now",
    "started_by",
    "context",
    "runs",
    "reads",
    "pull_requests",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "pass/1"
    },
    "pass": {
      "type": "string",
      "pattern": "^p_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "now": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "started_by": {
      "enum": [
        "schedule",
        "relay",
        "public",
        "own_repo",
        "successor",
        "dispatch"
      ]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "run-record.schema.json"
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read",
          "date",
          "age"
        ],
        "properties": {
          "read": {
            "enum": [
              "runs",
              "facts",
              "outcome",
              "advice_cost"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "age": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facts",
          "decision",
          "run"
        ],
        "properties": {
          "facts": {
            "$ref": "facts.schema.json"
          },
          "decision": {
            "$ref": "decision.schema.json"
          },
          "run": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^r_[0-9A-Z]{6,26}$"
          },
          "advisory_ask": {
            "type": "boolean"
          },
          "active_runs": {
            "description": "The count of active Runs this item's Decision was made with: the context's, and for an admission the Runs this pass mints for approvals and queue acts and the admissions before it, so no pass admits more Runs than the org's concurrency leaves room for (decision 0003). Absent on a record written before, whose every entry was asked with the context's.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "head": {
            "description": "The head commit read beside the facts, which the status on the item is posted on, so it describes the content the Decision was made on (#193's ruling 6). Present only where a status goes: absent on an item ended, not served or left hands-off, or whose label events cannot be read.",
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facts",
          "decision",
          "run"
        ],
        "properties": {
          "facts": {
            "$ref": "issue-facts.schema.json"
          },
          "decision": {
            "$ref": "issue-decision.schema.json"
          },
          "run": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^r_[0-9A-Z]{6,26}$"
          },
          "active_runs": {
            "description": "The count of active Runs this item's Decision was made with: the context's, and for an admission the Runs this pass mints for approvals and queue acts and the admissions before it, so no pass admits more Runs than the org's concurrency leaves room for (decision 0003). Absent on a record written before, whose every entry was asked with the context's.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "successor": {
      "description": "Whether the pass starts a successor, as it decided at its end: the one write a pass makes that no Decision in it calls for, held by the effects port to this. Absent in a record written before the effects port",
      "type": "boolean"
    },
    "alerts": {
      "description": "The pass's alerts, as its health gives them, sorted: what the tracking issue reports, less a Pause a person set (#193's ruling 8). Absent in a record written before the tracking issue",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "paused",
          "pause_unreadable",
          "capacity",
          "capacity_unreadable",
          "concurrency",
          "run_unidentified",
          "runs_unnamed",
          "environment",
          "facts_unreadable",
          "not_run",
          "write_unmatched",
          "hand_unmatched",
          "reconciliation_unreadable",
          "credential_due",
          "runs_never_started",
          "issue_apps_unreadable",
          "issue_budget_spent",
          "issue_list_unreadable"
        ]
      }
    },
    "advisory_doubt_until": {
      "description": "Until when no review may be told yes for its advisory readers, written by a pass that could not say what it carries in advisory_unlisted (the records before unread, or a yes it could not place) as an hour on, and carried by each pass that reads it until then (decision 0224, issue 932). Absent where no doubt stands.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "advisory_unlisted": {
      "description": "Each review a pass told yes for its advisory readers whose Run no run record lists yet, with when it was told, carried from record to record until its record is listed or an hour passes, and counted at the worst case meanwhile (decision 0224, issue 932). Absent in a record written before it; then the entries of the records before are read alone.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run",
          "told_at"
        ],
        "properties": {
          "run": {
            "type": "string",
            "pattern": "^r_[0-9A-Z]{6,26}$"
          },
          "told_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          }
        }
      }
    },
    "credentials_due": {
      "description": "The stored credentials near their limits, or whose rows cannot be read, by their secrets' names alone, sorted: the evidence of `credential_due` (issue 305). Absent in a record written before it",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "left_out": {
      "description": "Each item the pass left out, in the order read, with why: a read that moved while it was read (`pull_moved`), one GitHub did not answer (`facts_unanswered`), facts that are not facts, an item listed twice, an issue the pass's budget of issue requests left unread (`issue_budget`), or, with no item, an issue list read short, when no issue was read (`issue_list_unreadable`, decision 0234). The item is null where none can be named. The next pass reads it to tell a second move from a first (#658). Absent in a record written before it",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "code"],
        "properties": {
          "item": {
            "description": "The item as `facts/1` spells one, or null",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["repo", "type", "number"],
            "properties": {
              "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
              "type": {"enum": ["pull_request", "issue"]},
              "number": {"type": "integer", "minimum": 1}
            }
          },
          "code": {"enum": ["pull_moved", "facts_unanswered", "not_facts", "listed_twice", "issue_budget", "issue_list_unreadable"]}
        }
      }
    },
    "reconciliation": {
      "description": "What reconciliation found, as the view says it, each once: each write a Factory identity made that no Effect recorded, each resolution by a hand unmatched or unjudged (decision 0223), each merge read as an Override, each hand approval (decision 0241), and each issue that left read whole by its 404 or 410 (decision 1145), ids and codes alone (decision 0061). Absent in a record written before reconciliation",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "view-meta.schema.json#/$defs/entry"
      }
    },
    "reconciled": {
      "description": "What reconciliation has read in its window and the keys it held, each stamped with when it was read, so that the next pass reads only what is new (decision 0112). Absent in a record written before it; then everything in the window is read again.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "passes",
        "keys",
        "items",
        "dispatched",
        "owed"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^r_[0-9A-Z]{6,26}$"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        },
        "passes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "attempt",
              "at"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "where",
              "type",
              "key",
              "at"
            ],
            "properties": {
              "where": {
                "enum": [
                  "applied",
                  "written"
                ]
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z_]{1,40}$"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_=:-]{1,100}$"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "item",
              "count",
              "at"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z_]{1,40}$"
              },
              "item": {
                "type": "string",
                "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/(pull|issues)/[1-9][0-9]*$"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        },
        "dispatched": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run",
              "at"
            ],
            "properties": {
              "run": {
                "type": "string",
                "pattern": "^r_[0-9A-Z]{6,26}$"
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        },
        "owed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "left": {
          "description": "Each pull request a pass read as left, merged or closed, stamped with when one first did, kept until the window passes it, so that its writes are read and a write nobody matched keeps its alert as long as it is in the window (issue 787). Absent in a record written before it; then none is kept.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "at"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
            }
          }
        },
        "hands": {
          "description": "Each thread a Role opened whose resolution by a person was matched to the act `resolve_thread` that named it, stamped with when it was last seen and kept for the window, so that it matches at every pass that sees it (issue 854). Absent in a record written before it; then a pass that sees such a resolution is short, and carries it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "at"],
            "properties": {
              "key": {"type": "string", "pattern": "^[A-Za-z0-9_=:-]{1,100}$"},
              "at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
            }
          }
        },
        "taken": {
          "description": "Each head an approval not read as the hand took, any account's: its review's key (null if unread), its pull request and the head, kept while that is open or its leaving is held, so a later approval of the head is a second (decision 0241). Absent if none.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "item", "head"],
            "properties": {
              "key": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_=:-]{1,100}$"},
              "item": {"type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$"},
              "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "hand": {
          "description": "Each machine user approval read as the Maintainer's hand: its review's key, its pull request, the head and when given, kept while that is open or its leaving is held, so later passes read it as one and a second of that head is not (decision 0241). Absent if none.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "item", "head", "at"],
            "properties": {
              "key": {"type": "string", "pattern": "^[A-Za-z0-9_=:-]{1,100}$"},
              "item": {"type": "string", "pattern": "^https://github\\.com/[^/\\s]+/[^/\\s]+/pull/[1-9][0-9]*$"},
              "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
            }
          }
        },
        "owed_issues": {
          "description": "The issues whose writes a pass could not read, or carried unread where the issues were not listed, read until they have been (issue 916). Absent in a record written before it, or with none; then none is owed.",
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "left_issues": {
          "description": "Each issue a pass read as left, closed since a pass served it, stamped with when one first did, kept until the window passes it, as a pull request that left is (issue 916). Absent in a record written before it, or with none; then none is kept.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "at"],
            "properties": {
              "number": {"type": "integer", "minimum": 1},
              "at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "active_runs",
        "model_deferred_until",
        "passes_since",
        "unidentified_runs"
      ],
      "properties": {
        "paused": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active_runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "github_deferred": {
          "description": "Each Role and owner whose Runs wait for GitHub's limit to reset, and until when; only a Role that pushes waits on it. Null where the run records were read short, which may hide one; absent in a record written before it (decision 1269)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "owner",
              "until"
            ],
            "properties": {
              "role": {
                "type": "string",
                "pattern": "^[a-z][a-z-]*[a-z]$"
              },
              "owner": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "until": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            }
          }
        },
        "model_deferred_until": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "passes_since": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "unidentified_runs": {
          "description": "Each counted Run listed before its run-name: its GitHub run id, when its record was created and whether it is queued, in progress or completed, from which the Kernel reads whether it may still be a Run waiting for its name or running on an item (decision 0036, issue 270)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run",
              "created_at",
              "status"
            ],
            "properties": {
              "run": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "created_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              },
              "status": {
                "enum": [
                  "queued",
                  "in_progress",
                  "completed"
                ]
              }
            }
          }
        }
      }
    }
  }
}
