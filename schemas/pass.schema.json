{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pass/1: what one pass of the Controller read and decided, enough to replay every Decision it made: the time it gave the Kernel, what started it, the whole context, every run record, each read's date and age, and for each item its facts, its Decision and the Run id minted for an admission or an approval. The configuration is the data at release. There is no title anywhere in it: the facts have no field for one, so a replay, like the Kernel, never sees one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pass",
    "release",
    "now",
    "started_by",
    "context",
    "runs",
    "reads",
    "pull_requests",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "pass/1"
    },
    "pass": {
      "type": "string",
      "pattern": "^p_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "now": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "started_by": {
      "enum": [
        "schedule",
        "relay",
        "public",
        "own_repo",
        "successor",
        "dispatch"
      ]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "run-record.schema.json"
      }
    },
    "reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read",
          "date",
          "age"
        ],
        "properties": {
          "read": {
            "enum": [
              "runs",
              "facts",
              "outcome"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "age": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "pull_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facts",
          "decision",
          "run"
        ],
        "properties": {
          "facts": {
            "$ref": "facts.schema.json"
          },
          "decision": {
            "$ref": "decision.schema.json"
          },
          "run": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^r_[0-9A-Z]{6,26}$"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "facts",
          "decision",
          "run"
        ],
        "properties": {
          "facts": {
            "$ref": "issue-facts.schema.json"
          },
          "decision": {
            "$ref": "issue-decision.schema.json"
          },
          "run": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^r_[0-9A-Z]{6,26}$"
          }
        }
      }
    },
    "successor": {
      "description": "Whether the pass starts a successor, as it decided at its end: the one write a pass makes that no Decision in it calls for, held by the effects port to this. Absent in a record written before the effects port",
      "type": "boolean"
    },
    "alerts": {
      "description": "The pass's alerts, as its health gives them, sorted: what the tracking issue reports, less a Pause a person set (#193's ruling 8). Absent in a record written before the tracking issue",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "paused",
          "pause_unreadable",
          "capacity",
          "capacity_unreadable",
          "concurrency",
          "run_unidentified",
          "runs_unnamed",
          "environment",
          "facts_unreadable",
          "not_run",
          "write_unmatched",
          "reconciliation_unreadable",
          "credential_due",
          "runs_never_started"
        ]
      }
    },
    "credentials_due": {
      "description": "The stored credentials near their limits, or whose rows cannot be read, by their secrets' names alone, sorted: the evidence of `credential_due` (issue 305). Absent in a record written before it",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "reconciliation": {
      "description": "What reconciliation found, as the view says it, each once: each write a Factory identity made that no Effect recorded, and each merge read as an Override, ids and codes alone (decision 0061). Absent in a record written before reconciliation",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "view-meta.schema.json#/$defs/entry"
      }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paused",
        "active_runs",
        "model_deferred_until",
        "passes_since",
        "unidentified_runs"
      ],
      "properties": {
        "paused": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active_runs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_deferred_until": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "passes_since": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "unidentified_runs": {
          "description": "Each counted Run listed before its run-name: its GitHub run id, when its record was created and whether it is queued, in progress or completed, from which the Kernel reads whether it may still be a Run waiting for its name or running on an item (decision 0036, issue 270)",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "run",
              "created_at",
              "status"
            ],
            "properties": {
              "run": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "created_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              },
              "status": {
                "enum": [
                  "queued",
                  "in_progress",
                  "completed"
                ]
              }
            }
          }
        }
      }
    }
  }
}
