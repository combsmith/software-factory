{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feed/1: how a Decision's codes become who acts next and what is asked of a person, as data the Controller and the page both read. next_actor is read in order: by_outcome first, then by_attention, where an actor of by_state sends the reader to by_state and its default. decision_required has one row for each reason the Kernel gives needs_you.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "next_actor",
    "decision_required"
  ],
  "properties": {
    "schema": {
      "const": "feed/1"
    },
    "next_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "by_outcome",
        "by_attention",
        "by_state"
      ],
      "properties": {
        "by_outcome": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "actor"
            ],
            "properties": {
              "outcome": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "nothing",
                    "defer",
                    "hold",
                    "act",
                    "admit"
                  ]
                }
              },
              "actor": {
                "$ref": "#/$defs/actor"
              }
            }
          }
        },
        "by_attention": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attention",
              "actor"
            ],
            "properties": {
              "attention": {
                "enum": [
                  "needs_you",
                  "failed",
                  "review",
                  "ready",
                  "working",
                  "stale",
                  "none"
                ]
              },
              "actor": {
                "enum": [
                  "maintainer",
                  "author",
                  "lens",
                  "factory",
                  "platform",
                  "nobody",
                  "by_state"
                ]
              }
            }
          }
        },
        "by_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rows",
            "default"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "actor"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "draft",
                      "verifying",
                      "addressing",
                      "adjudicating",
                      "converged",
                      "queued",
                      "held",
                      "merged",
                      "closed",
                      "not_served",
                      "new",
                      "triage",
                      "ready",
                      "in_progress",
                      "in_review",
                      "done",
                      "declined"
                    ]
                  },
                  "actor": {
                    "$ref": "#/$defs/actor"
                  }
                }
              }
            },
            "default": {
              "$ref": "#/$defs/actor"
            }
          }
        }
      }
    },
    "decision_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason",
          "question",
          "choices"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "question": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/choice"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "actor": {
      "enum": [
        "maintainer",
        "author",
        "lens",
        "factory",
        "platform",
        "nobody"
      ]
    },
    "choice": {
      "enum": [
        "end_hold",
        "admit",
        "renew_allowance",
        "approve",
        "approve_contract",
        "resolve_thread",
        "fix_the_source",
        "end_pause",
        "split_the_change",
        "close"
      ]
    }
  }
}
