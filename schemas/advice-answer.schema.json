{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "advice-answer/1: what an advisory Lens's reader answers when it is asked to read a change, one object and nothing beside it (decision 0224). A clean read is findings: []. An answer that does not validate is no read, never 'no findings'. Every word of it is the reader's, derived from the author's diff: its severity is kept on the advisory Finding as an opinion, its category and criterion are hints, and its title and message are text that reaches a person and `pr-review` as data and no decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "advice-answer/1"
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "criterion",
          "file",
          "line",
          "title",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor",
              "info"
            ]
          },
          "category": {
            "enum": [
              "functional",
              "security",
              "architecture",
              "delivery",
              "reliability",
              "requirements",
              "mechanical",
              "uncategorised",
              "human"
            ]
          },
          "criterion": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^PR-[0-9]{1,3}$"
          },
          "file": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\u00ad\\u180e\\u2060-\\u2064\\ufff9-\\ufffb\\ud800-\\udfff\\U000e0000-\\U000e007f]{1,1024}$"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 999999999
          },
          "title": {
            "type": "string",
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2066-\\u2069\\ufeff\\u00ad\\u180e\\u2060-\\u2064\\ufff9-\\ufffb\\ud800-\\udfff\\U000e0000-\\U000e007f]{1,200}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65333
          }
        }
      }
    }
  }
}
