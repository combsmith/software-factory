{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage/1: what a reviewing Result says of each criterion of its rubric. Whether it reports on every criterion that applies is for kernel/coverage.py to say; no schema can.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "criterion",
      "verdict",
      "reason"
    ],
    "properties": {
      "criterion": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]+$"
      },
      "verdict": {
        "enum": [
          "met",
          "finding",
          "not_applicable"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[a-z_]+$"
      }
    }
  }
}
