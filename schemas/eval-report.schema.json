{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-report/1: what the eval job uploads of one run over a held-out set: the Release and commit it judged, the set by its count and the sha256 of its manifest, and each case by its id and hash with its verdict and the codes that say why it was not read or what the scorer found (decisions 0109 and 0120). Each is a code of this enum. No case's content and no word of the model's is here, and none may be.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "commit",
    "role",
    "intent",
    "set",
    "cases",
    "passed",
    "split_ok",
    "kinds_pass",
    "blocking_pass"
  ],
  "properties": {
    "schema": {
      "const": "eval-report/1"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "verdict",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreadable"
            ]
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "schema",
                "not_found",
                "hash_differs",
                "too_large",
                "unanswered",
                "not_this_set",
                "facts_not_current",
                "facts_read_short",
                "diff_unreadable",
                "diff_not_content",
                "pusher_unnamed",
                "diff_not_whole",
                "issue_not_whole",
                "issue_unreadable",
                "credential_missing",
                "engine_version",
                "engine_failed",
                "no_answer",
                "engine_timeout",
                "task_too_large",
                "rubric_unreadable",
                "answer_off_rubric",
                "result_not_completed",
                "finding_not_raised",
                "finding_uncited",
                "finding_cites_another",
                "finding_elsewhere",
                "category_differs",
                "severity_differs",
                "location_differs",
                "coverage_disagrees",
                "finding_raised_wrongly",
                "criterion_not_met",
                "answer_disagrees_with_verdict",
                "location_unreadable",
                "criterion_unknown"
              ]
            }
          },
          "cause": {
            "description": "Why a case was unanswered or stopped by the Engine, where the job found it: an exception's class and the last line of this repo's code it passed, a step's code, the CLI's subtype and exit, or that it timed out. Never a message.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exception": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$" },
              "at": { "type": "string", "pattern": "^(adapters|controller|harness|kernel|release|tools)/[a-z0-9_/]+\\.py:[1-9][0-9]{0,5}$" },
              "stop": { "type": "string", "pattern": "^[a-z][a-z_]{0,63}$" },
              "subtype": { "type": "string", "pattern": "^[a-z][a-z_]{0,63}$" },
              "exit": { "type": "integer", "minimum": -255, "maximum": 255 },
              "timed_out": { "const": true }
            }
          }
        }
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "blocking_pass": {
      "description": "Whether every case that expects a blocking Finding passed (decision 0120): one word, never how many. Null where a case was not read or its answer is no kind.",
      "type": ["boolean", "null"]
    },
    "kinds_pass": {
      "description": "Whether at least the bar of each kind passed (decision 0120): one word for each, never how many. Null where a case was not read or its answer is no kind.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["finding", "met"],
      "properties": {
        "finding": { "type": "boolean" },
        "met": { "type": "boolean" }
      }
    },
    "split_ok": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
