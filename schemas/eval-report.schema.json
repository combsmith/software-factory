{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-report/1: what the eval job uploads of one run over a held-out set: the Release and commit it judged, the set by its count and the sha256 of its manifest, and each case by its id and hash with its verdict and the codes that say why. No case's content and no word of the model's is here, and none may be.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "commit",
    "role",
    "intent",
    "set",
    "cases",
    "passed"
  ],
  "properties": {
    "schema": {
      "const": "eval-report/1"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "verdict",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreadable"
            ]
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "schema",
                "answer_disagrees_with_verdict",
                "location_unreadable",
                "criterion_unknown",
                "result_not_completed",
                "finding_not_raised",
                "category_differs",
                "severity_differs",
                "location_differs",
                "coverage_disagrees",
                "finding_raised_wrongly",
                "criterion_not_met",
                "not_found",
                "hash_differs",
                "too_large",
                "unanswered",
                "not_this_set"
              ]
            }
          }
        }
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    }
  }
}
