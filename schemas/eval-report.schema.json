{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eval-report/1: what the eval job uploads of one run over a held-out set: the Release and commit it judged, the set by its count and the sha256 of its manifest, and each case by its id and hash with its verdict and the codes that say why it was not read, or `case_failed` for any case the scorer did not pass: what the scorer said would tell what a case expected, and the report is public. No case's content and no word of the model's is here, and none may be.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "commit",
    "role",
    "intent",
    "set",
    "cases",
    "passed",
    "split_ok"
  ],
  "properties": {
    "schema": {
      "const": "eval-report/1"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "verdict",
          "reasons"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreadable"
            ]
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "schema",
                "not_found",
                "hash_differs",
                "too_large",
                "unanswered",
                "not_this_set",
                "facts_not_current",
                "facts_read_short",
                "diff_unreadable",
                "diff_not_content",
                "pusher_unnamed",
                "diff_not_whole",
                "credential_missing",
                "engine_version",
                "engine_failed",
                "engine_timeout",
                "task_too_large",
                "rubric_unreadable",
                "answer_off_rubric",
                "case_failed"
              ]
            }
          }
        }
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "split_ok": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
