{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What one part of a split eval run wrote, for the merge job to make the one report of (issue 611)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "part",
    "release",
    "commit",
    "role",
    "intent",
    "set",
    "asked",
    "passed",
    "kinds",
    "blocking",
    "origin",
    "faults",
    "preflight",
    "usage",
    "models",
    "cases",
    "ledger"
  ],
  "properties": {
    "schema": {
      "const": "eval-part/1"
    },
    "part": {
      "description": "The preflight, or a shard by its number from 0.",
      "type": "string",
      "pattern": "^(preflight|[0-9]|1[0-5])$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "asked": {
      "description": "How many of the set's cases the part was given.",
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "kinds": {
      "description": "Of each kind, the part's cases and how many passed: counts alone, which the merge sums. Null where a case of the part was not read or its answer is no kind.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "finding",
        "met"
      ],
      "properties": {
        "finding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "passed"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "met": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "passed"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "blocking": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "cases",
        "passed"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "The part's cases that expect a blocking Finding, and how many passed; null where `kinds` is."
    },
    "origin": {
      "description": "The cases the manifest marks natural and those it does not, each counted with how many passed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "natural",
        "constructed"
      ],
      "properties": {
        "natural": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "passed"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "constructed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cases",
            "passed"
          ],
          "properties": {
            "cases": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "faults": {
      "description": "Each code of a case not read, with how many cases gave it: never which.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "count"
        ],
        "properties": {
          "code": {
            "enum": [
              "schema",
              "not_found",
              "hash_differs",
              "too_large",
              "unanswered",
              "not_this_set",
              "facts_not_current",
              "facts_read_short",
              "diff_unreadable",
              "diff_not_content",
              "pusher_unnamed",
              "diff_not_whole",
              "issue_not_whole",
              "issue_unreadable",
              "credential_missing",
              "engine_version",
              "engine_model",
              "engine_failed",
              "no_answer",
              "engine_timeout",
              "task_too_large",
              "rubric_unreadable",
              "head_unreadable",
              "answer_off_rubric",
              "result_not_completed",
              "finding_not_raised",
              "finding_uncited",
              "finding_cites_another",
              "finding_elsewhere",
              "category_differs",
              "severity_differs",
              "location_differs",
              "coverage_disagrees",
              "finding_raised_wrongly",
              "finding_not_in_hunk",
              "surplus_at_place",
              "surplus_gating_elsewhere",
              "criterion_not_met",
              "answer_disagrees_with_verdict",
              "location_unreadable",
              "criterion_unknown"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "preflight": {
      "description": "The development cases the dispatch asked first, its set's `preflight`, scored apart and counted in nothing else here: how many there were, how many passed, and each code of one not read (issue 613). One stopped by the Engine or the run, or none passed, stopped the dispatch before any of the set's cases was asked, and each of those is then `unanswered`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases",
        "passed",
        "faults"
      ],
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "description": "Each code of a preflight case not read, with how many cases gave it: never which.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "count"
            ],
            "properties": {
              "code": {
                "enum": [
                  "schema",
                  "not_found",
                  "hash_differs",
                  "too_large",
                  "unanswered",
                  "not_this_set",
                  "facts_not_current",
                  "facts_read_short",
                  "diff_unreadable",
                  "diff_not_content",
                  "pusher_unnamed",
                  "diff_not_whole",
                  "issue_not_whole",
                  "issue_unreadable",
                  "credential_missing",
                  "engine_version",
                  "engine_model",
                  "engine_failed",
                  "no_answer",
                  "engine_timeout",
                  "task_too_large",
                  "rubric_unreadable",
                  "head_unreadable",
                  "answer_off_rubric",
                  "result_not_completed",
                  "finding_not_raised",
                  "finding_uncited",
                  "finding_cites_another",
                  "finding_elsewhere",
                  "category_differs",
                  "severity_differs",
                  "location_differs",
                  "coverage_disagrees",
                  "finding_raised_wrongly",
                  "finding_not_in_hunk",
                  "surplus_at_place",
                  "surplus_gating_elsewhere",
                  "criterion_not_met",
                  "answer_disagrees_with_verdict",
                  "location_unreadable",
                  "criterion_unknown"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "usage": {
      "description": "What the Results spent, summed over those whose usage was whole, and how many those were.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answered",
        "input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens",
        "turns",
        "cost_usd",
        "seconds"
      ],
      "properties": {
        "answered": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "models": {
      "description": "Each model the CLI said answered a case, by the id it gave, not the configured name (issue 616): one where the run is whole.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]{1,64}$"
      }
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "verdict",
          "reasons",
          "usage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "unreadable"
            ]
          },
          "reasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "schema",
                "not_found",
                "hash_differs",
                "too_large",
                "unanswered",
                "not_this_set",
                "facts_not_current",
                "facts_read_short",
                "diff_unreadable",
                "diff_not_content",
                "pusher_unnamed",
                "diff_not_whole",
                "issue_not_whole",
                "issue_unreadable",
                "credential_missing",
                "engine_version",
                "engine_model",
                "engine_failed",
                "no_answer",
                "engine_timeout",
                "task_too_large",
                "rubric_unreadable",
                "head_unreadable",
                "answer_off_rubric",
                "result_not_completed",
                "finding_not_raised",
                "finding_uncited",
                "finding_cites_another",
                "finding_elsewhere",
                "category_differs",
                "severity_differs",
                "location_differs",
                "coverage_disagrees",
                "finding_raised_wrongly",
                "finding_not_in_hunk",
                "surplus_at_place",
                "surplus_gating_elsewhere",
                "criterion_not_met",
                "answer_disagrees_with_verdict",
                "location_unreadable",
                "criterion_unknown"
              ]
            }
          },
          "usage": {
            "description": "What the case used, from the CLI's own answer: turns and cost in USD, null where the CLI reported none or was never asked, and seconds, 0 where it was never asked (issue 616). Numbers alone.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turns",
              "cost_usd",
              "seconds"
            ],
            "properties": {
              "turns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cost_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "at_alternate": {
            "description": "A pass whose Finding was at a place of the case's also_at alone, not its location (decision 0143): a mark the report can count, saying no place.",
            "type": "boolean",
            "const": true
          },
          "cause": {
            "description": "Why a case was unanswered or stopped by the Engine, where the job found it: an exception's class and the last line of this repo's code it passed, a step's code, the CLI's subtype and exit, or that it timed out. Never a message.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exception": {
                "type": "string",
                "pattern": "^[A-Z][A-Za-z0-9_]{0,63}$"
              },
              "at": {
                "type": "string",
                "pattern": "^(adapters|controller|harness|kernel|release|tools)/[a-z0-9_/]+\\.py:[1-9][0-9]{0,5}$"
              },
              "stop": {
                "type": "string",
                "pattern": "^[a-z][a-z_]{0,63}$"
              },
              "subtype": {
                "type": "string",
                "pattern": "^[a-z][a-z_]{0,63}$"
              },
              "exit": {
                "type": "integer",
                "minimum": -255,
                "maximum": 255
              },
              "timed_out": {
                "const": true
              }
            }
          },
          "surplus_gating": {
            "description": "On a case that expects a Finding, how many gating Findings the Result put away from every place the case gives (issue 610): a count the report can sum, saying no place.",
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "description": "A development set's cases of the part, as its report lists them; none for a gate set, whose part holds counts alone."
    },
    "ledger": {
      "description": "A gate set's part's ledger: the sha256 of it under its salt, and of its ciphertext, which the seal step writes. None for a development set.",
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "part",
          "salted_sha256",
          "sealed_sha256"
        ],
        "properties": {
          "part": {
            "type": "string",
            "pattern": "^(preflight|[0-9]|1[0-5])$"
          },
          "salted_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sealed_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
