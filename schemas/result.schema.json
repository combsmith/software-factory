{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result/1: what one Run judged, and only that, as `run` uploads it. The Engine writes schema, run, status (completed, incomplete or refused), reason, dispositions, findings, effects and coverage; the Harness fills release and usage, and writes a failed Result whole. No field names a Role, an App, an actor, a content id or a commit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run",
    "release",
    "status",
    "reason",
    "dispositions",
    "findings",
    "effects",
    "coverage",
    "usage"
  ],
  "properties": {
    "schema": {
      "const": "result/1"
    },
    "run": {
      "type": "string",
      "pattern": "^r_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed",
        "refused",
        "superseded"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z_]+$"
    },
    "dispositions": {
      "type": "array",
      "items": {
        "$ref": "disposition.schema.json"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/raised"
      }
    },
    "effects": {
      "$ref": "effect.schema.json"
    },
    "coverage": {
      "$ref": "coverage.schema.json"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engine_version",
        "model",
        "session",
        "input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens",
        "turns",
        "cost_usd",
        "seconds"
      ],
      "properties": {
        "engine": {
          "const": "claude-cli"
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "session": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "turns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "raised": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "category",
        "severity",
        "criterion"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[0-9]{1,3}$"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[^\\s]+$"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1
            },
            "end_line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "category": {
          "enum": [
            "functional",
            "security",
            "architecture",
            "delivery",
            "reliability",
            "requirements",
            "mechanical",
            "uncategorised",
            "human"
          ]
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor",
            "info"
          ]
        },
        "criterion": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]+-[0-9]+$"
        },
        "adopted_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lens",
            "surface"
          ],
          "properties": {
            "lens": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "surface": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "thread",
                    "alert",
                    "annotation",
                    "check",
                    "role"
                  ]
                },
                "key": {
                  "type": "string",
                  "pattern": "^[^\\s]+$"
                }
              }
            }
          }
        }
      }
    }
  }
}
