{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "advice/1: one advisory Lens's Result for one review Run, the file the advise step always ends in (decision 0224). It holds codes: a status, a reason from a fixed list, Findings that are each a finding/1 of an advisory source on an annotation, uncategorised and with no criterion, and what the read cost. A reader's words are under `body` alone, one text for each Finding, by its id. It approves nothing and names no Role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run",
    "release",
    "lens",
    "status",
    "reason",
    "findings",
    "texts",
    "off_change",
    "usage"
  ],
  "properties": {
    "schema": {
      "const": "advice/1"
    },
    "run": {
      "type": "string",
      "pattern": "^r_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "lens": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "status": {
      "enum": [
        "completed",
        "incomplete",
        "failed"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "too_large",
        "cut_short",
        "unparsed",
        "not_the_model",
        "rate_limited",
        "refused",
        "timed_out",
        "no_key",
        "transport",
        "budget"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/advised"
      }
    },
    "texts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "criterion",
          "body"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[0-9a-f]{64}$"
          },
          "category": {
            "enum": [
              "functional",
              "security",
              "architecture",
              "delivery",
              "reliability",
              "requirements",
              "mechanical",
              "uncategorised",
              "human"
            ]
          },
          "criterion": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^PR-[0-9]{1,3}$"
          },
          "body": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "off_change": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "deployment",
        "model",
        "answering_model",
        "effort",
        "asks",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "seconds"
      ],
      "properties": {
        "api": {
          "enum": [
            "responses",
            "chat"
          ]
        },
        "deployment": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "answering_model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
        },
        "effort": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "asks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "advised": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "source",
        "surface",
        "category",
        "severity",
        "criterion",
        "content_id"
      ],
      "properties": {
        "schema": {
          "const": "finding/1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[0-9a-f]{64}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lens",
            "kind",
            "actor"
          ],
          "properties": {
            "lens": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "kind": {
              "const": "advisory"
            },
            "actor": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}@[a-z0-9][a-z0-9.-]{0,127}$"
            }
          }
        },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key"
          ],
          "properties": {
            "type": {
              "const": "annotation"
            },
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[0-9a-f]{64}$"
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001f\\u007f]{1,1024}$"
            },
            "start_line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999999
            }
          }
        },
        "category": {
          "const": "uncategorised"
        },
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor",
            "info"
          ]
        },
        "criterion": {
          "type": "null"
        },
        "content_id": {
          "$ref": "finding.schema.json#/$defs/content_id"
        }
      }
    }
  }
}
