{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What the session hooks are told: whose name a commit or a push in this repo carries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maintainer"
  ],
  "properties": {
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login",
        "name",
        "email"
      ],
      "properties": {
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s<>]+@[^@\\s<>]+$"
        }
      }
    }
  }
}
