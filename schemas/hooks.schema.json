{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What the session hooks are told: whose name a commit or a push in this repo carries, and what is asked of the person.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "maintainer",
    "protected",
    "merging",
    "settings"
  ],
  "properties": {
    "maintainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login",
        "name",
        "email"
      ],
      "properties": {
        "login": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s<>]+@[^@\\s<>]+$"
        }
      }
    },
    "protected": {
      "description": "Paths an edit to which is asked of the person, relative to the top of any working tree. A path ending in / is a directory and all below it; * stands for any part of one name.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "is"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(^|/)\\.{1,2}(/|$))[A-Za-z0-9_.*-]+(/[A-Za-z0-9_.*-]+)*/?$"
          },
          "is": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "merging": {
      "description": "What merges a pull request or adds one to the queue: a push to the branch, a gh command, a GraphQL mutation or a REST endpoint written to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commands",
        "mutations",
        "endpoints"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "commands": {
          "$ref": "#/$defs/commands"
        },
        "mutations": {
          "$ref": "#/$defs/mutations"
        },
        "endpoints": {
          "$ref": "#/$defs/endpoints"
        }
      }
    },
    "settings": {
      "description": "What writes a ruleset or the repo's settings: a gh command, a GraphQL mutation or a REST endpoint written to.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "mutations",
        "endpoints"
      ],
      "properties": {
        "commands": {
          "$ref": "#/$defs/commands"
        },
        "mutations": {
          "$ref": "#/$defs/mutations"
        },
        "endpoints": {
          "$ref": "#/$defs/endpoints"
        }
      }
    }
  },
  "$defs": {
    "commands": {
      "description": "gh's words for a command, after gh and its options; a longer command starting with them is asked about too.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)*$"
      }
    },
    "mutations": {
      "description": "GraphQL mutation names; * stands for any part of a name.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z*]+$"
      }
    },
    "endpoints": {
      "description": "REST paths written to with any method but GET or HEAD. * stands for one part, and a final /** for any number of parts, none included.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z-]*(/([a-z][a-z-]*|\\*))*(/\\*\\*)?$"
      }
    }
  }
}
