{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One Run, as the records port reports it after checking workflow, event and repo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run",
    "item",
    "role",
    "intent",
    "content_id",
    "status",
    "conclusion",
    "outcome",
    "started_at"
  ],
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
    },
    "item": {
      "$ref": "#/$defs/item"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "intent": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*[a-z]$"
    },
    "content_id": {
      "$ref": "#/$defs/content_id"
    },
    "status": {
      "enum": [
        "queued",
        "in_progress",
        "completed"
      ]
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "cancelled",
        "timed_out",
        null
      ]
    },
    "outcome": {
      "enum": [
        "item",
        "capacity",
        "environment",
        "superseded",
        null
      ]
    },
    "started_at": {
      "$ref": "#/$defs/time"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "type",
        "number"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "type": {
          "enum": [
            "pull_request",
            "issue"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "content_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{4,64}$"
    }
  }
}
