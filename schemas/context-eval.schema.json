{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context-eval/1: the context's test (issue 8). The sha256 of its one task sentence and of its held-out answer, both of which live in the private home and never here, and each run of a fresh agent on it: the commit, what it read, what it changed, what it cost, and the three verdicts. Of the model's text only the first words of its commands and the paths it named reach here, and of the rule nothing: whether it added a test, a mutant and the sentence's reason code is three booleans, each held to a pattern and none shaped like a token; a change is a count, and what the agent named outside the export, what it ran that could not be read, and what of the judge's was put back are counted. A cost is null when the CLI gave no result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_sha256",
    "held_out_sha256",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "context-eval/1"
    },
    "task_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "held_out_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "ran_at",
          "cli_version",
          "cap_turns",
          "task_sha256",
          "read",
          "outside_reads",
          "ran",
          "unread_commands",
          "changed",
          "restored",
          "added",
          "cost",
          "verdicts",
          "passed"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "ran_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "cli_version": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)+$"
          },
          "cap_turns": {
            "type": "integer",
            "minimum": 1
          },
          "task_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "read": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.?[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"
            }
          },
          "outside_reads": {
            "type": "integer",
            "minimum": 0
          },
          "ran": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_./=-]+( [a-z0-9_./=-]+){0,3}$"
            }
          },
          "unread_commands": {
            "type": "integer",
            "minimum": 0
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "added",
                "removed"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.?[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"
                },
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "restored": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\.?[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"
            }
          },
          "added": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test",
              "mutant",
              "reason"
            ],
            "properties": {
              "test": {
                "type": "boolean"
              },
              "mutant": {
                "type": "boolean"
              },
              "reason": {
                "type": "boolean"
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turns",
              "duration_ms",
              "usd",
              "input_tokens",
              "output_tokens"
            ],
            "properties": {
              "turns": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "verdicts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_out_test",
              "verify",
              "mutant"
            ],
            "properties": {
              "held_out_test": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "verify": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "mutant": {
                "enum": [
                  "killed",
                  "survived",
                  "missing"
                ]
              }
            }
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
