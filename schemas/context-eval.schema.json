{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context-eval/1: the context's test (issue 8). One task sentence, the sha256 of its held-out answer, which lives in the private home and never here, and each run of a fresh agent on it: the commit, what it read, what it changed, what it cost, and the three verdicts. No text of the model's is here, and none may be: a read is a path, a command is its first words, a change is a count.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task",
    "held_out_sha256",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "context-eval/1"
    },
    "task": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][^.\\n]{10,398}\\.$"
    },
    "held_out_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "ran_at",
          "cli_version",
          "cap_turns",
          "read",
          "ran",
          "changed",
          "added",
          "cost",
          "verdicts",
          "passed"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "ran_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "cli_version": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)+$"
          },
          "cap_turns": {
            "type": "integer",
            "minimum": 1
          },
          "read": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"
            }
          },
          "ran": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_./-]+( [a-z0-9_./=-]+){0,3}$"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "added",
                "removed"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]{0,199}$"
                },
                "added": {
                  "type": "integer",
                  "minimum": 0
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "added": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test",
              "mutant",
              "reason"
            ],
            "properties": {
              "test": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^tests/[A-Za-z0-9_/]+\\.py::test_[a-z0-9_]+$"
              },
              "mutant": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z0-9][a-z0-9 _:'-]{0,99}$"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-z_]+$"
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "turns",
              "duration_ms",
              "usd",
              "input_tokens",
              "output_tokens"
            ],
            "properties": {
              "turns": {
                "type": "integer",
                "minimum": 0
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              },
              "usd": {
                "type": "number",
                "minimum": 0
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "verdicts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "held_out_test",
              "verify",
              "mutant"
            ],
            "properties": {
              "held_out_test": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "verify": {
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "mutant": {
                "enum": [
                  "killed",
                  "survived",
                  "missing"
                ]
              }
            }
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
