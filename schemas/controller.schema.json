{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "controller/1: what the Controller's pass is told beside the Kernel's configuration: the accounts that tell what started a pass, by type and id and never by a name's spelling, each null until a trial records it (decision 0043); how long a pass waits after the last pass's read began, and how long with no pass is the not-run alert's second reading; how long a capacity fault defers model Runs; how many environment faults, on how many items, in what window, pause Admission automatically (L-59); and decision 0011's thresholds and their window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "accounts",
    "read_gap_seconds",
    "not_run_seconds",
    "capacity_window_seconds",
    "automatic_pause",
    "thresholds",
    "home",
    "workflows"
  ],
  "properties": {
    "schema": {
      "const": "controller/1"
    },
    "accounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_token",
        "relay",
        "controller",
        "maintainer",
        "approver",
        "lenses",
        "agents",
        "dependencies",
        "roles"
      ],
      "properties": {
        "workflow_token": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "enum": [
                "Bot",
                "User"
              ]
            }
          }
        },
        "relay": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "type"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "enum": [
                "Bot",
                "User"
              ]
            }
          }
        },
        "controller": {
          "description": "The Controller's App's bot account, by id, type and login, as GitHub records it as an issue's author; null until a trial records it, and while it is, no tracking issue is written",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "login"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "type": {
              "const": "Bot"
            },
            "login": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
            }
          }
        },
        "maintainer": {
          "description": "The Maintainer, by login and account id, whom the tracking issue assigns once, when it opens (#193, the Maintainer's point (d))",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "login",
            "id"
          ],
          "properties": {
            "login": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "approver": {
          "description": "The machine user, the approver config/defaults.json names, by login and account id, a User: its acts are the Factory's, and its approval stands only while it can write; null until a trial records it",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "login",
            "id"
          ],
          "properties": {
            "login": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
            },
            "id": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "lenses": {
          "description": "Each model Lens's App's bot account, by the Lens's name, as GitHub records it as a thread's author; empty until a trial records one, and while a Lens has none, nothing its App does is read as that Lens's",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "login",
              "id"
            ],
            "properties": {
              "lens": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,60}$"
              },
              "login": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
              },
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "agents": {
          "description": "The bot accounts of the Factory's own Role Apps that author pull requests, as the class `agent` reads them; empty until a trial records one, and while it is, no pull request is the Factory's own",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "login",
              "id"
            ],
            "properties": {
              "login": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
              },
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "dependencies": {
          "description": "The bot accounts whose pull requests are of the class `dependency`, each by login and account id",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "login",
              "id"
            ],
            "properties": {
              "login": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
              },
              "id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "roles": {
          "description": "Each Role App's bot account, by id, type and login, keyed by its name in config/apps.json, every one named: a Role left out could not be told; null until a trial records it, and while one is, reconciliation is short (decision 0061)",
          "type": "object",
          "required": [
            "pr-review"
          ],
          "additionalProperties": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "login"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "type": {
                "const": "Bot"
              },
              "login": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*\\[bot\\]$"
              }
            }
          }
        }
      }
    },
    "read_gap_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "not_run_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "capacity_window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "automatic_pause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faults",
        "items",
        "window_seconds"
      ],
      "properties": {
        "faults": {
          "type": "integer",
          "minimum": 2
        },
        "items": {
          "type": "integer",
          "minimum": 2
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_seconds",
        "job_minutes_share",
        "graphql_points_per_hour",
        "decision_delay_p95_minutes"
      ],
      "properties": {
        "window_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "job_minutes_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "graphql_points_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "decision_delay_p95_minutes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "home": {
      "description": "The Factory's own repo and the branch its Runs are dispatched on",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "branch"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]{1,100}$"
        }
      }
    },
    "workflows": {
      "description": "The workflow file a dispatch of each kind starts, under .github/workflows/; the records port lists the run and approval files as the Role workflow files",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "approval",
        "poller"
      ],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,60}\\.yml$"
        },
        "approval": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,60}\\.yml$"
        },
        "poller": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,60}\\.yml$"
        }
      }
    }
  }
}
