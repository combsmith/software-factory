{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The least permissions each of the Factory's GitHub Apps holds, each with what needs it. Until a Consumer repo is served (slice 3), each App is installed on named repos only; from then, as decided at that cutover, against UJ-6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "needs",
    "apps"
  ],
  "properties": {
    "schema": {
      "const": "apps/1"
    },
    "needs": {
      "title": "Each need, and the one GitHub permission and level that serves it, or what it waits on. An Effect of section 3.6 of the design; a write the Controller makes that is not an Effect; or a read: a field of facts/1, the Factory's run records, or what a Task is built from.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect:submit_review",
        "effect:resolve_thread",
        "effect:comment",
        "effect:enqueue_merge",
        "effect:dequeue_merge",
        "effect:assign",
        "effect:add_label",
        "effect:remove_label",
        "write:status_on_item",
        "write:tracking_issue",
        "write:write_view",
        "read:facts.item",
        "read:facts.targets_protected",
        "read:facts.class",
        "read:facts.state",
        "read:facts.is_draft",
        "read:facts.author",
        "read:facts.last_pusher",
        "read:facts.mergeable",
        "read:facts.label_events",
        "read:facts.last_push_at",
        "read:facts.last_writer_action_at",
        "read:facts.reviews",
        "read:facts.threads",
        "read:facts.queue",
        "read:facts.content_id",
        "read:facts.diff",
        "read:facts.checks",
        "read:records.runs",
        "read:records.artifacts",
        "read:records.pass_record",
        "read:task.change",
        "read:task.thread_texts",
        "read:task.issue_texts"
      ],
      "properties": {
        "effect:submit_review": {
          "$ref": "#/$defs/mapping"
        },
        "effect:resolve_thread": {
          "$ref": "#/$defs/mapping"
        },
        "effect:comment": {
          "$ref": "#/$defs/mapping"
        },
        "effect:enqueue_merge": {
          "$ref": "#/$defs/mapping"
        },
        "effect:dequeue_merge": {
          "$ref": "#/$defs/mapping"
        },
        "effect:assign": {
          "$ref": "#/$defs/mapping"
        },
        "effect:add_label": {
          "$ref": "#/$defs/mapping"
        },
        "effect:remove_label": {
          "$ref": "#/$defs/mapping"
        },
        "write:status_on_item": {
          "$ref": "#/$defs/mapping"
        },
        "write:tracking_issue": {
          "$ref": "#/$defs/mapping"
        },
        "write:write_view": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.item": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.targets_protected": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.class": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.state": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.is_draft": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.author": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.last_pusher": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.mergeable": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.label_events": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.last_push_at": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.last_writer_action_at": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.reviews": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.threads": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.queue": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.content_id": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.diff": {
          "$ref": "#/$defs/mapping"
        },
        "read:facts.checks": {
          "$ref": "#/$defs/mapping"
        },
        "read:records.runs": {
          "$ref": "#/$defs/mapping"
        },
        "read:records.artifacts": {
          "$ref": "#/$defs/mapping"
        },
        "read:records.pass_record": {
          "$ref": "#/$defs/mapping"
        },
        "read:task.change": {
          "$ref": "#/$defs/mapping"
        },
        "read:task.thread_texts": {
          "$ref": "#/$defs/mapping"
        },
        "read:task.issue_texts": {
          "$ref": "#/$defs/mapping"
        }
      }
    },
    "apps": {
      "title": "One App for the Controller, one for each Role that writes, and the one reader.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "pr-review",
        "reader"
      ],
      "properties": {
        "controller": {
          "$ref": "#/$defs/app"
        },
        "pr-review": {
          "$ref": "#/$defs/app"
        },
        "reader": {
          "$ref": "#/$defs/app"
        }
      }
    }
  },
  "$defs": {
    "mapping": {
      "title": "A permission and a level, or waits_on; never both, never neither.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "level": {
          "$ref": "#/$defs/level"
        },
        "waits_on": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "permission": {
      "title": "GitHub's own names for an App's repository permissions. A name not here is refused; add it when an App needs it.",
      "enum": [
        "actions",
        "checks",
        "contents",
        "issues",
        "metadata",
        "pull_requests"
      ]
    },
    "level": {
      "enum": [
        "read",
        "write"
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "app_id",
        "key",
        "permissions",
        "installed_on"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^combsmith-sf-[a-z][a-z-]*$"
        },
        "app_id": {
          "title": "GitHub's id for the registered App. Trial P-39 reads what was granted to the installation of this id, and tools/check_apps.py holds the permissions here to it.",
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "title": "Where the App's private key is kept, by name and never by value: an environment secret on the Factory's repo, in the environment of the one job that holds it (decision 0035): the Controller's in factory-poller, the reader's in factory-run, and every Role's in factory-apply, which Roles' keys may share. tools/check_apps.py holds it to that, and the secret to the App's name.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment",
            "secret"
          ],
          "properties": {
            "environment": {
              "enum": [
                "factory-poller",
                "factory-apply",
                "factory-run"
              ]
            },
            "secret": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*_APP_KEY$"
            }
          }
        },
        "installed_on": {
          "title": "Each repo the App is installed on, by name, and never the whole org, until a Consumer repo is served (slice 3).",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "combsmith/software-factory",
              "combsmith/software-factory-canary"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actions": {
              "$ref": "#/$defs/grant"
            },
            "checks": {
              "$ref": "#/$defs/grant"
            },
            "contents": {
              "$ref": "#/$defs/grant"
            },
            "issues": {
              "$ref": "#/$defs/grant"
            },
            "metadata": {
              "$ref": "#/$defs/grant"
            },
            "pull_requests": {
              "$ref": "#/$defs/grant"
            }
          }
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "needs"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "effect:submit_review",
              "effect:resolve_thread",
              "effect:comment",
              "effect:enqueue_merge",
              "effect:dequeue_merge",
              "effect:assign",
              "effect:add_label",
              "effect:remove_label",
              "write:status_on_item",
              "write:tracking_issue",
              "write:write_view",
              "read:facts.item",
              "read:facts.targets_protected",
              "read:facts.class",
              "read:facts.state",
              "read:facts.is_draft",
              "read:facts.author",
              "read:facts.last_pusher",
              "read:facts.mergeable",
              "read:facts.label_events",
              "read:facts.last_push_at",
              "read:facts.last_writer_action_at",
              "read:facts.reviews",
              "read:facts.threads",
              "read:facts.queue",
              "read:facts.content_id",
              "read:facts.diff",
              "read:facts.checks",
              "read:records.runs",
              "read:records.artifacts",
              "read:records.pass_record",
              "read:task.change",
              "read:task.thread_texts",
              "read:task.issue_texts"
            ]
          }
        }
      }
    }
  }
}
