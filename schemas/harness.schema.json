{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harness/1: what the Harness is told beside the Role's manifest: the Engine's CLI, by name, the version it is pinned to and the model it runs, by its full id and never an alias the CLI resolves; each tier's limits, its effort among them; how many characters of text a Task carries, and of the change's diff apart; and the third-party reviewers whose text is advisory, by the name the facts give their Lens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine",
    "limits",
    "texts",
    "advisory"
  ],
  "properties": {
    "schema": {
      "const": "harness/1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model"
      ],
      "properties": {
        "name": {
          "const": "claude-cli"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "model": {
          "type": "string",
          "pattern": "^claude-[a-z]+(-[0-9]+)+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "deep"
      ],
      "properties": {
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns",
            "repair_turns",
            "seconds",
            "cost_ceiling_usd",
            "effort"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1
            },
            "repair_turns": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0.01
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns",
            "repair_turns",
            "seconds",
            "cost_ceiling_usd",
            "effort"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1
            },
            "repair_turns": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0.01
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "advisory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "eval_shards": {
      "description": "How many shards the eval job's run is split into, each a job of its own with its own time limit, behind one preflight job (issue 611).",
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "gate_set": {
      "description": "The gate set the Release's eval gate reads, by its name under evals/: every dispatch of the eval job on the commit is pooled (issue 613). Absent, the gate reads the review Intent's set, evals/pr-review, by its newest successful dispatch.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
