{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harness/1: what the Harness is told beside the Role's manifest: the Engine's CLI, by name, the version it is pinned to and the model it runs, by its full id and never an alias the CLI resolves; each tier's limits, its effort among them; how many characters of text a Task carries, and of the change's diff apart; and the third-party reviewers whose text is advisory, by the name the facts give their Lens.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "engine",
    "limits",
    "texts",
    "advisory"
  ],
  "properties": {
    "schema": {
      "const": "harness/1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "model"
      ],
      "properties": {
        "name": {
          "const": "claude-cli"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "model": {
          "type": "string",
          "pattern": "^claude-[a-z]+(-[0-9]+)+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standard",
        "deep"
      ],
      "properties": {
        "standard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns",
            "repair_turns",
            "seconds",
            "cost_ceiling_usd",
            "effort"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1
            },
            "repair_turns": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0.01
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        },
        "deep": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turns",
            "repair_turns",
            "seconds",
            "cost_ceiling_usd",
            "effort"
          ],
          "properties": {
            "turns": {
              "type": "integer",
              "minimum": 1
            },
            "repair_turns": {
              "type": "integer",
              "minimum": 0
            },
            "seconds": {
              "type": "integer",
              "minimum": 1
            },
            "cost_ceiling_usd": {
              "type": "number",
              "minimum": 0.01
            },
            "effort": {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          }
        }
      }
    },
    "texts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters"
      ],
      "properties": {
        "characters": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "advisory": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "gate_set": {
      "description": "The gate set the Release's eval gate reads, by its name under evals/: every dispatch of the eval job on the commit is pooled (issue 613). Absent, the gate reads the review Intent's set, evals/pr-review, by its newest successful dispatch.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "review": {
      "description": "What a private replay may switch on, one approach at a time, in its own copy of this file, to measure the review Role's recall (issue 581): a pass per changed file, the whole Task asked more than once and joined, a fault checklist per criterion, or reading the head before a criterion is met. The committed file never gives it, so a review is asked once, whole, as it always was.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passes": {
          "enum": [
            "whole",
            "per_file"
          ]
        },
        "runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "checklist": {
          "type": "boolean"
        },
        "read_head": {
          "type": "boolean"
        }
      }
    },
    "readers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "deployment",
          "model",
          "api",
          "effort",
          "output_tokens",
          "prompt_characters",
          "seconds",
          "usd_per_million"
        ],
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.(openai\\.azure\\.com|services\\.ai\\.azure\\.com|cognitiveservices\\.azure\\.com)$"
          },
          "deployment": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,127}$"
          },
          "api": {
            "enum": [
              "responses",
              "chat"
            ]
          },
          "effort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "critical",
              "elsewhere"
            ],
            "properties": {
              "critical": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "elsewhere": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "prompt_characters": {
            "description": "The most the reader's prompt may hold, counted in its UTF-8 bytes, not its characters; the worst case prices the prompt at a token a byte (decision 0224).",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1200
          },
          "usd_per_million": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input",
              "output"
            ],
            "properties": {
              "input": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 10000
              },
              "output": {
                "type": "number",
                "minimum": 1e-06,
                "maximum": 10000
              }
            }
          }
        }
      }
    },
    "advisory_ceiling_usd_per_day": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 10000
    }
  }
}
