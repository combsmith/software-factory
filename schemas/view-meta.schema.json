{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "view-meta/1: when the feed was written, by which pass and Release, and how far back its run records reach. The pass is the one view-items/1 carries, so a page can tell a matched pair from two files written by different passes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pass",
    "release",
    "written_at",
    "reaches_back_to",
    "alerts"
  ],
  "properties": {
    "schema": {
      "const": "view-meta/1"
    },
    "pass": {
      "type": "string",
      "pattern": "^p_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "written_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "reaches_back_to": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "alerts": {
      "description": "The alerts of the whole scope the pass found, by ids and codes alone: for each counted Run listed unnamed for max_unnamed_run_seconds or more, run_unnamed and its run id, until a person deletes the run (issue 270), written from kernel.decide.unnamed_scope; for each write a Factory identity made that no Effect recorded, write_unmatched, by whom, what and its key; and for each merge read as an Override, merged_by_override and its item (decision 0061). One alert is raised for all of them however many there are",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/alert"
      }
    }
  },
  "$defs": {
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert"
      ],
      "properties": {
        "alert": {
          "enum": [
            "run_unnamed",
            "write_unmatched",
            "merged_by_override"
          ]
        },
        "run": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "by": {
          "type": "string",
          "pattern": "^[a-z][a-z_-]{0,60}[a-z]$"
        },
        "write": {
          "enum": [
            "review",
            "approval",
            "comment",
            "check_run",
            "resolution",
            "label",
            "enqueue",
            "dequeue",
            "merge",
            "close",
            "reopen",
            "dismissal",
            "rename",
            "ready",
            "draft",
            "auto_merge",
            "retarget",
            "force_push",
            "branch_deleted",
            "lock",
            "push",
            "dispatch"
          ]
        },
        "item": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(pull|issues)/[1-9][0-9]*$"
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_=:-]{1,100}$"
        }
      }
    }
  }
}
