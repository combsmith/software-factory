{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "view-meta/1: when the feed was written, by which pass and Release, and how far back its run records reach. The pass is the one view-items/1 carries, so a page can tell a matched pair from two files written by different passes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pass",
    "release",
    "written_at",
    "reaches_back_to",
    "alerts"
  ],
  "properties": {
    "schema": {
      "const": "view-meta/1"
    },
    "pass": {
      "type": "string",
      "pattern": "^p_[0-9A-Z]{6,26}$"
    },
    "release": {
      "type": "string",
      "pattern": "^factory/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "written_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "reaches_back_to": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "alerts": {
      "description": "The alerts of the whole scope the pass found, one to a cause however many items it touches: for each counted Run listed unnamed for max_unnamed_run_seconds or more, the alert run_unnamed and its run id, until a person deletes the run (issue 270). Written from kernel.decide.stuck_runs",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alert",
          "run"
        ],
        "properties": {
          "alert": {
            "const": "run_unnamed"
          },
          "run": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    }
  }
}
