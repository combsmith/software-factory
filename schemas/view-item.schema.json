{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One Work item on the feed: its Decision's codes, who acts next and what is asked, read from the Decision through config/feed.json, with the only text on the feed, the item's title, held under untrusted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item",
    "state",
    "reason",
    "attention",
    "evidence",
    "next_actor",
    "decision_required",
    "content_id",
    "age_hours",
    "attempts",
    "runs",
    "cost_usd",
    "sources",
    "url",
    "untrusted"
  ],
  "properties": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "type",
        "number"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "type": {
          "enum": [
            "pull_request",
            "issue"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "state": {
      "enum": [
        "draft",
        "verifying",
        "addressing",
        "adjudicating",
        "converged",
        "queued",
        "held",
        "merged",
        "closed",
        "not_served",
        "new",
        "triage",
        "ready",
        "in_progress",
        "in_review",
        "done",
        "declined",
        null
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "attention": {
      "enum": [
        "needs_you",
        "failed",
        "review",
        "ready",
        "working",
        "stale",
        "none"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
      }
    },
    "next_actor": {
      "$ref": "feed.schema.json#/$defs/actor"
    },
    "decision_required": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "question",
        "choices",
        "evidence"
      ],
      "properties": {
        "question": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "feed.schema.json#/$defs/choice"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"
          }
        }
      }
    },
    "content_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{4,64}$"
    },
    "age_hours": {
      "type": "number",
      "minimum": 0
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "count"
        ],
        "properties": {
          "intent": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*[a-z]$"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "runs": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^r_[0-9A-Z]{6,26}$"
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(pull|issues)/[1-9][0-9]*$"
    },
    "untrusted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string"
        }
      }
    }
  }
}
